# Copy to .env.local and fill in real values. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — never put secrets there.

# --- Chain selection ---
NEXT_PUBLIC_DEFAULT_CHAIN=sepolia

# --- Contract addresses, per chain (public) ---
NEXT_PUBLIC_SEPOLIA_CONTRACT_ADDRESS=
NEXT_PUBLIC_POLKADOT_HUB_TESTNET_CONTRACT_ADDRESS=

# --- Server-only secrets (never NEXT_PUBLIC_) ---
# e.g. RPC provider API keys used only in Server Components / Route Handlers
